# P23 Ethical Sneaker Price Monitor — Environment Configuration Template
# Copy this file to .env and replace placeholder values before running in non-dev environments.

ENVIRONMENT=development
APP_NAME="P23 Ethical Sneaker Price Monitor"
DATABASE_URL=sqlite:///./data/pricemonitor.db
# Docker Compose / Production PostgreSQL 16 example:
# DATABASE_URL=postgresql+psycopg://pricemonitor:pricemonitor@db:5432/pricemonitor

POSTGRES_DB=pricemonitor
POSTGRES_USER=pricemonitor
POSTGRES_PASSWORD=pricemonitor

# IMPORTANT: Generate a strong random secret key for production/staging sessions
SECRET_KEY=replace-with-strong-random-secret-key
SESSION_COOKIE_NAME=p23_session
SESSION_MAX_AGE_SECONDS=604800

# D-002 Polite Scraping Policy Bounds
DEFAULT_POLLING_INTERVAL_MINUTES=360
DEFAULT_MIN_DELAY_SECONDS=10
DEFAULT_MAX_REQUESTS_PER_HOUR=30
ROBOTS_CACHE_TTL_HOURS=24

# Demo Seed Accounts (override before running python3 -m app.db.seed on exposed instances)
SEED_ADMIN_EMAIL=admin@pricemonitor.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_USER_EMAIL=user@pricemonitor.local
SEED_USER_PASSWORD=change-me-user-password

# Optional Notification Channels
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
